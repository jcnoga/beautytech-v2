{
  // Só para o "npm run check" (tsc --noEmit). O Vite lê apenas tsconfig.json, então isto não muda o build.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false
  },
  "include": ["src"],
  // Cópia antiga do App.tsx em UTF-16, não importada (ver IGNORE em scripts/check.mjs).
  "exclude": ["src/App_HEAD.tsx"]
}
