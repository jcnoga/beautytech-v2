# BEAUTYTECH v2 — Frontend .env.example
# Dominio publico: o Traefik encaminha /auth/v1 para o GoTrue
VITE_SUPABASE_URL=https://zensalon.99labpro.com.br
# JWT {"role":"anon"} assinado com GOTRUE_JWT_SECRET (o GoTrue nao valida, mas o supabase-js exige)
VITE_SUPABASE_ANON_KEY=eyJ...
 
# SEM /api/v1 no final — o client.ts adiciona automaticamente
VITE_API_URL=https://beautytech-v2-backend.railway.app
